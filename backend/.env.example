# ==========================================
# burger.sh - Backend Configuration
# ==========================================
# Copia questo file in .env e riempisci i valori reali.
# .env NON deve essere commitato su git.
# ==========================================

# ─── MongoDB ──────────────────────────────
# Per produzione: inserisci qui la URI di MongoDB Atlas
# Esempio: mongodb+srv://user:pass@cluster.mongodb.net/burger
MONGODB_URI=

# ─── JWT ──────────────────────────────────
# Chiave segreta per firmare i token JWT (minimo 32 caratteri)
JWT_SECRET=

# ─── Server ───────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Opzionale (solo per sviluppo) ───────
# Se vuoi usare MongoDB locale invece di Atlas:
# MONGODB_URI=mongodb://localhost:27017/burger
# NODE_ENV=development
