# copia questo file in .env e riempi i valori veri.
# .env non va mai committato: è già in .gitignore.

# stringa di connessione MongoDB. richiesta, letta da config/db.js.
# MONGO_URI è accettata come alias se MONGODB_URI non è definita.
MONGODB_URI=mongodb://localhost:27017/fastfood

# secret usato per firmare e verificare i JWT (utils/jwt.js). richiesto:
# l'app non si avvia senza (vedi app.js). usa una stringa lunga e casuale,
# diversa per ogni ambiente.
JWT_SECRET=changeme

# porta su cui ascolta il server HTTP (bin/www). opzionale, default 3000.
PORT=3000

# endpoint dell'API di geocodifica Nominatim (services/osmService.js).
# opzionale: di default punta al servizio pubblico di OpenStreetMap.
# utile per puntare a un'istanza self-hosted nei test o in CI.
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# User-Agent inviato a Nominatim, richiesto dalla policy del servizio
# (services/osmService.js). opzionale, ha già un default sensato.
# OSM_USER_AGENT=burger.sh (https://github.com/MrJoelao/burger.sh)
